# syntax=docker/dockerfile:1.7

FROM rust:1.89-bookworm AS rust-build

WORKDIR /opt/remote-codex

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

RUN --mount=type=cache,id=remote-codex-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=remote-codex-cargo-target,target=/opt/remote-codex/target,sharing=locked \
    cargo build --locked --release --package remote-codex \
    && install -Dm0755 target/release/remote-codex /out/remote-codex

FROM node:22-bookworm-slim AS web-build

ARG REMOTE_CODEX_THREAD_UI_REPO=https://github.com/dufangshi/remote-codex-thread-ui.git
ARG REMOTE_CODEX_THREAD_UI_COMMIT=4b426dbfe6eb8b2e0c801b6a515911172791c0f1
ARG REMOTE_CODEX_THREAD_UI_CACHE_BUST=local

ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@10.11.1 --activate

WORKDIR /opt/remote-codex

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/supervisor-web ./apps/supervisor-web
COPY packages/plugin-runtime ./packages/plugin-runtime
COPY packages/plugin-terminal ./packages/plugin-terminal
COPY packages/shared ./packages/shared

RUN echo "thread-ui cache key: ${REMOTE_CODEX_THREAD_UI_CACHE_BUST}" \
    && git init ./remote-codex-thread-ui \
    && git -C ./remote-codex-thread-ui remote add origin "${REMOTE_CODEX_THREAD_UI_REPO}" \
    && git -C ./remote-codex-thread-ui fetch --depth 1 origin "${REMOTE_CODEX_THREAD_UI_COMMIT}" \
    && git -C ./remote-codex-thread-ui checkout --detach FETCH_HEAD

RUN --mount=type=cache,id=remote-codex-pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm config set store-dir /pnpm/store \
    && pnpm --dir ./remote-codex-thread-ui install --frozen-lockfile \
    && pnpm --dir ./remote-codex-thread-ui --filter @remote-codex/thread-ui build \
    && pnpm --filter @remote-codex/supervisor-web... install --frozen-lockfile \
    && pnpm --filter @remote-codex/supervisor-web build

FROM debian:bookworm-slim AS runtime

ARG REMOTE_CODEX_UID=1000
ARG REMOTE_CODEX_GID=1000

ENV HOST=0.0.0.0 \
    PORT=8788 \
    REMOTE_CODEX_RELAY_HOST=0.0.0.0 \
    REMOTE_CODEX_RELAY_PORT=8788 \
    REMOTE_CODEX_RELAY_DATA_DIR=/var/lib/remote-codex-relay \
    REMOTE_CODEX_RELAY_WEB_DIST_DIR=/opt/remote-codex/apps/supervisor-web/dist

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid "${REMOTE_CODEX_GID}" remote-codex \
    && useradd \
      --uid "${REMOTE_CODEX_UID}" \
      --gid "${REMOTE_CODEX_GID}" \
      --home-dir /var/lib/remote-codex-relay \
      --no-create-home \
      --shell /usr/sbin/nologin \
      remote-codex \
    && install -d -o "${REMOTE_CODEX_UID}" -g "${REMOTE_CODEX_GID}" \
      /var/lib/remote-codex-relay \
      /opt/remote-codex/apps/supervisor-web/dist

COPY --from=rust-build --chown=1000:1000 /out/remote-codex /usr/local/bin/remote-codex
COPY --from=web-build --chown=1000:1000 /opt/remote-codex/apps/supervisor-web/dist /opt/remote-codex/apps/supervisor-web/dist

WORKDIR /opt/remote-codex

USER 1000:1000

EXPOSE 8788
VOLUME ["/var/lib/remote-codex-relay"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl --fail --silent --show-error --max-time 4 \
    "http://127.0.0.1:${REMOTE_CODEX_RELAY_PORT:-8788}/healthz" >/dev/null

CMD ["remote-codex", "relay"]
