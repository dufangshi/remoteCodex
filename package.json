{
  "name": "remote-codex",
  "version": "0.12.2",
  "description": "Self-hosted control plane for coding agents. Rust supervisor, ACP runtimes, React thread UI.",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "cargo build --release && pnpm --filter @remote-codex/supervisor-web build",
    "dev": "concurrently -k -n api,web -c blue,green \"REMOTE_CODEX_E2E_FAKE_RUNTIME=${REMOTE_CODEX_E2E_FAKE_RUNTIME:-} cargo run -p remote-codex -- supervisor\" \"pnpm --filter @remote-codex/supervisor-web exec vite --host localhost --port 5173\"",
    "test": "cargo test --workspace",
    "test:e2e": "playwright test",
    "test:e2e:harness": "playwright test e2e/harness-acp.spec.ts --project=desktop-chromium",
    "test:e2e:relay": "playwright test e2e/relay-mode.spec.ts --project=desktop-chromium",
    "npm:prepare": "node scripts/prepare-npm-release.mjs",
    "npm:pack": "node scripts/pack-npm-release.mjs",
    "npm:publish": "node scripts/publish-npm-release.mjs",
    "npm:publish:test": "node --test scripts/publish-npm-release.test.mjs scripts/npm-launcher-download.test.mjs",
    "npm:verify": "node scripts/verify-npm-package.mjs",
    "version:set": "node scripts/set-version.mjs",
    "typecheck": "pnpm --filter @remote-codex/supervisor-web typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "concurrently": "^9.1.2"
  }
}
